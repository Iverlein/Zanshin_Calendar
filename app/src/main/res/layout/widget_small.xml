<?xml version="1.0" encoding="utf-8"?>
<!--
  The small widget (SPEC §10.6, ROADMAP W1): the civil date and the calendar, the calendar's day and month,
  and the Tibetan day's tone with its reason, or the 旧暦 brief's counts. Every text and colour is set by
  DayWidget at each update; the values here are the picker's preview, in Ink.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_page"
        android:tint="#FF111311" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/widget_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/figtree"
                android:maxLines="1"
                android:text="@string/widget_preview_date"
                android:textColor="#FFA6A99F"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_calendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/figtree"
                android:maxLines="1"
                android:text="@string/calendar_tibetan"
                android:textColor="#FFE3A94F"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/shippori_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="6"
                android:textColor="#FFECE8DF"
                android:textSize="36dp" />

            <TextView
                android:id="@+id/widget_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/figtree"
                android:maxLines="1"
                android:text="@string/widget_preview_month"
                android:textColor="#FFECE8DF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_tone_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="#FF9CCB98" />

            <TextView
                android:id="@+id/widget_tone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/figtree"
                android:maxLines="2"
                android:text="@string/brief_day_good"
                android:textColor="#FFECE8DF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree"
            android:maxLines="2"
            android:text="@string/brief_by_combination"
            android:textColor="#FFA6A99F"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_avoid_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree"
            android:maxLines="2"
            android:text="@string/brief_avoid_all"
            android:textColor="#FFE8826F"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_counts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_good_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree"
                android:maxLines="1"
                android:textColor="#FF9CCB98"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_avoid_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/figtree"
                android:maxLines="1"
                android:textColor="#FFE8826F"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- The compact variant's counts, on one line (SPEC §10.6). -->
        <LinearLayout
            android:id="@+id/widget_counts_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_good_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree"
                android:maxLines="1"
                android:textColor="#FF9CCB98"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_avoid_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/figtree"
                android:maxLines="1"
                android:textColor="#FFE8826F"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
