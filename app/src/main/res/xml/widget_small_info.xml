<?xml version="1.0" encoding="utf-8"?>
<!-- The small widget (SPEC §10.6): two cells by two; DayWidget updates it by its own alarm, not by the system's period. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_small_description"
    android:initialLayout="@layout/widget_small"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:previewLayout="@layout/widget_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
